{
  // Cloudflare Workers project (Workers Builds): pushing to main deploys.
  // Sign-ups for the study sites' daily emails, and the morning sending.
  "name": "daily-mail",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  // logs in the dashboard (the worker's Observability tab)
  "observability": { "enabled": true },
  // mornings 03:15-09:15 UTC, and 18:15 + 19:15 UTC (21:15 Israel in summer / winter)
  // for Shabbat and Yom Tov; the worker itself decides what is due (SEND_HOUR, HOLY_HOUR)
  "triggers": { "crons": ["15 3-9,18,19 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "daily-mail", "database_id": "43ae5629-e739-490f-afec-44157d1cdb6b" }
  ],
  "vars": {
    "PUBLIC_URL": "https://daily-mail.dailylearning.workers.dev",
    // the Gmail account the emails come from, and the name readers see
    "GMAIL_USER": "dailylearningparshanachmishna@gmail.com",
    "FROM_NAME": "לימוד יומי",
    "SEND_HOUR": "7",
    // on Shabbat and Yom Tov the day's email waits until this hour (Israel) of the last holy day
    "HOLY_HOUR": "21",
    // weekly readers get the 7 days ending on this weekday: 0 = Sunday .. 5 = Friday
    "WEEK_DAY": "5",
    // gets a separate note for every confirmed sign-up (readers never see it)
    "NOTIFY_EMAIL": "rosenbaum.jeremy@gmail.com"
  }
  // secret, set in the Cloudflare dashboard (Settings > Variables and Secrets):
  // GMAIL_APP_PASSWORD, a Google app password for GMAIL_USER
}
